# - XIC_infantry_entity: integrated_dlc\dlc022_waking_the_tiger\gfx\entities\wtt_units_infantry.asset
# - SND_infantry_entity: integrated_dlc\dlc022_waking_the_tiger\gfx\entities\wtt_units_infantry.asset
# - GDC_infantry_entity: integrated_dlc\dlc022_waking_the_tiger\gfx\entities\wtt_units_infantry.asset
