# MiyagiPatch 1.19 compatibility: restore vanilla entity definitions shadowed by older mod asset files.
# Source files:
# - ENG_artillery_gun_entity: gfx\entities\units_artillery.asset
# - ENG_anti_tank_gun_entity: gfx\entities\units_artillery.asset
# - JAP_anti_tank_gun_entity: gfx\entities\units_artillery.asset
# - JAP_light_plane_1_entity: gfx\entities\units_planes.asset
# - JAP_light_plane_3_entity: gfx\entities\units_planes.asset
# - CHI_infantry_entity_snow: integrated_dlc\dlc022_waking_the_tiger\gfx\entities\wtt_units_infantry.asset
# - CHI_infantry_alt_0_entity: integrated_dlc\dlc022_waking_the_tiger\gfx\entities\wtt_units_infantry.asset
# - RAJ_militia_entity: integrated_dlc\dlc018_together_for_victory\gfx\entities\tfv_units_infantry.asset
# - AST_infantry_entity_desert: integrated_dlc\dlc018_together_for_victory\gfx\entities\tfv_units_infantry.asset
# - KHM_infantry_entity: integrated_dlc\dlc022_waking_the_tiger\gfx\entities\wtt_units_infantry.asset
# - NXM_infantry_entity: integrated_dlc\dlc022_waking_the_tiger\gfx\entities\wtt_units_infantry.asset
# - GSM_infantry_entity: integrated_dlc\dlc022_waking_the_tiger\gfx\entities\wtt_units_infantry.asset
